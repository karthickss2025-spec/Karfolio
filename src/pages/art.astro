const artworks = [
  {
    title: "Creepface",
    image: "/art/creepface.png",
    type: "Digital Illustration",
    year: "2026",
  category: "digital",
    description:
      "This piece was created during the early stages of my grandma's struggles. The contrast between the featureless head and the detailed, life-like eyes represents how someone's view of the world anchors them. If I had seen my struggles in a different light, I would have remained grounded, and I realize that today. While the featureless desert of a face reminds me of serious illness, I believe perspective can make or break how someone copes. Furthermore, the hands represent suffocation, where I believed I could not speak out through any medium other than art."
  },

  {
    title: "title",
    image: "/art/",
    type: "Digital Art",
    year: "2026",
  category: "digital",
    description:
      "A study focused on color, atmosphere, and visual storytelling."
  },

  {
    title: "Y2K GUILT",
    image: "/art/sketching.png",
    type: "Digital Illustration",
    year: "2025",
  category: "digital",
    description:
      "Created in 2025, this piece was a rough sketch of how I felt and what I observed past my previous struggles. Other than various parts of the body floating in space, spiky organisms depict illness, and they stick onto the borders of the page as if they won't leave me alone. A black void is opened up in the middle, and echoes the emptiness of space as if it were in my chest cavity. This piece is named Y2K GUILT due to my sense of survivor's guilt, and specifically Y2K for the style I was going for at the time."
  },

  {
  title: "Abstraction",
  image: "/art/abstractportrait.png",
  type: "Digital Illustration",
  year: "2026",
  category: "digital",
  description:
    "This piece was created recently, and is a reflection on the emotional growth I have went through as of now. Stars are a symbol of hope for many, but also remain largely unexplored by mankind- at least physically. The calmness of my face contrasts with the star in order to highlight both my acknowledgement of life's hardships, and the hope that blooms within me once again. As for the eye, it is vertical and peeks out the star, representing my perspective, and suggesting that I could be wrong."
},

